# Copy this file to .env and fill in the values. Never commit .env.

# Database (local PostgreSQL). Format: postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=
# A separate database that the tests may wipe. Its name must end with _test.
TEST_DATABASE_URL=

# Supabase (Google sign-in only). Project URL, like https://abcd1234.supabase.co
SUPABASE_URL=
# Optional: only for Supabase projects that still sign tokens with the shared secret
SUPABASE_JWT_SECRET=

# Encrypts users' LLM keys in the database. Never change it once keys are saved.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=

# Platform Gemini key: chat summaries (and embeddings in stage 2)
PLATFORM_GEMINI_API_KEY=
# Small, cheap Gemini model used for chat summaries
SUMMARY_MODEL=

# The only web origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

# Optional developer tracing (off unless LANGSMITH_TRACING=true)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
