# Copy this file to .env and fill in the values. Never commit .env.

# Database (local PostgreSQL). Format: postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=
# A separate database that the tests may wipe. Its name must end with _test.
TEST_DATABASE_URL=

# Supabase (Google sign-in only). Project URL, like https://abcd1234.supabase.co
SUPABASE_URL=
# Optional: only for Supabase projects that still sign tokens with the shared secret
SUPABASE_JWT_SECRET=

# Encrypts users' LLM keys in the database. Never change it once keys are saved.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=

# Platform Gemini key: chat summaries (and embeddings in stage 2)
PLATFORM_GEMINI_API_KEY=
# Small, cheap Gemini model used for chat summaries
SUMMARY_MODEL=gemini-3.5-flash-lite

# The only web origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

# Optional developer tracing (off unless LANGSMITH_TRACING=true)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Self-hosted Chroma DB that stores the knowledge-base vectors, like http://my-server:8000
CHROMA_URL=
# Gemini embedding model for the knowledge base. Changing it means re-indexing every document.
EMBEDDING_MODEL=gemini-embedding-2

# Platform keys for the outside-service tools. A tool whose key is empty is hidden.
SERPAPI_API_KEY=
SERPER_API_KEY=
FINNHUB_API_KEY=
# Used by searches when the user does not say where (two-letter country, three-letter currency)
DEFAULT_COUNTRY=in
DEFAULT_CURRENCY=INR
